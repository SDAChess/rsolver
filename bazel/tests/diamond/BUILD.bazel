load("//rust:binary.bzl", "rust_binary")
load("//rust:library.bzl", "rust_library")

# Two different crates named `util` meet in `top`.
rust_library(
    name = "left",
    crate_root = "left.rs",
    edition = "2024",
    deps = ["//tests/diamond/a:util"],
)

rust_library(
    name = "right",
    crate_root = "right.rs",
    edition = "2024",
    deps = ["//tests/diamond/b:util"],
)

rust_library(
    name = "top",
    crate_root = "top.rs",
    edition = "2024",
    deps = [
        ":left",
        ":right",
    ],
)

rust_binary(
    name = "diamond_bin",
    crate_root = "main.rs",
    edition = "2024",
    visibility = ["//tests:__pkg__"],
    deps = [":top"],
)
